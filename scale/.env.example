# =============================================================================
#  ####  LOCAL STAND ONLY — THE BACKENDS RUN WITH AUTHENTICATION DISABLED  ####
#
#  docker-compose.yml next to this file starts both backend copies with
#  OIDC_MOCK_ENABLED=true. Every request is then authenticated as a mock user,
#  and the `x-mock-sub` header picks WHICH user, with no token and no password.
#  Anyone who can reach the port is an authenticated user.
#
#  It is there because POST /upload sits behind requireAuth and curl cannot
#  complete an OIDC login, so the scenario script could not upload anything
#  otherwise. NEVER copy this stand, or the flag, onto a shared or public host.
#  The backend refuses to boot with it when NODE_ENV=production — that guard is
#  the last line of defence, not a licence to try.
# =============================================================================

# This file is documentation, not a prerequisite: the stand starts with no .env
# at all, because every value in docker-compose.yml carries a default. Copy it
# to `.env` in THIS directory only when a default does not suit your machine —
# compose reads that file automatically.
#
#   docker compose -f scale/docker-compose.yml up -d --wait
#   docker compose -f scale/docker-compose.yml down -v

# --- Host ports -------------------------------------------------------------
# The only ports the stand publishes, all on 127.0.0.1. Change them if something
# else on your machine already listens there. Inside the container Caddy always
# uses 8080-8084, so the Caddyfile never changes with them.
#
# SCALE_HTTP_PORT is the stand's public entry: the frontend, /graphql, /upload,
# the probes, and the public file links under /uploads. It is also the host and
# port baked into every value the apps are configured with (S3_PUBLIC_BASE_URL,
# VITE_GRAPHQL_API_URL, CORS_ORIGIN, …), so changing it moves all of them.
SCALE_HTTP_PORT=8080

# One address per copy, so a scenario can say WHICH copy answers: upload through
# the backend on 8081, read the profile back through the one on 8082; fetch the
# page from the frontend on 8083 and again from 8084. Nothing else is reachable
# per copy — the app containers publish no host port of their own, so that no
# request can bypass the proxy (which would make the rate-limit scenario
# meaningless).
SCALE_BACKEND_A_PORT=8081
SCALE_BACKEND_B_PORT=8082
SCALE_FRONTEND_A_PORT=8083
SCALE_FRONTEND_B_PORT=8084

# --- What is NOT configurable here ------------------------------------------
# Passwords, storage keys and the RPC secret are fixed fake values written into
# docker-compose.yml. They are not secrets and must never become real ones: the
# stand is loopback-only and is wiped with `down -v`. There is nothing here to
# fill in before running it.
#
# Postgres, Redis and Garage are shared by all four app containers on purpose —
# that shared state is exactly what makes one copy interchangeable with another.
# DB_POOL_MAX is 5 per backend copy: 2 copies x 5 = 10 connections, comfortably
# under the database's default limit of 100. That is the sizing rule from
# docs/ENV-CONTRACT.md applied to this stand.
#
# TRUSTED_PROXY_HOPS is 1 because exactly one proxy (the Caddy in this stand)
# stands in front of the app. Raising it here would mean believing an address
# the client wrote, which is the very thing the rate-limit scenario checks.

# --- Where the images come from ---------------------------------------------
# Both sides are BUILT from the submodule checkouts (../backend, ../frontend) on
# every `up`, not pulled from a registry: the stand's whole point is to run the
# code that is in this working tree right now. Nothing has to be published, or
# built by hand, first — but the very first run pays for a Go build and an npm
# ci + Vite build, so give it a few minutes. Later runs hit the layer cache.
#
# Only copy A of each side carries the build; copy B runs the tag copy A
# produced, so the two copies are provably the same image and the two services
# cannot race each other building the same tag.
