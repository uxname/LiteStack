// LiteStack architecture diagrams (LikeC4 format).
// Run from the META-REPO ROOT (likec4 is a devDependency there):
//   browse:   npm run likec4:start
//   validate: npm run likec4:validate
// Fallback without an install: npx -y likec4@1 <command> docs/architecture/likec4
// (the CLI major is pinned: the scoped @likec4/cli package is a dead 0.x line
// without the validate command). Tested with likec4 1.59.3.
// Rule: changed code or deploy configs (compose/Dockerfile/ENV-CONTRACT) —
// update this diagram in the same commit.
//
// LiteStack is a boilerplate meta-repository: it owns no application code,
// only two submodules (backend/ = liteend-go, frontend/ = litefront) and the
// shared contracts. The diagram shows the system as it lives in production,
// plus the "build server → registry → run server" deployment path from
// docs/DEPLOY.md.
//
// READ THIS FIRST — both apps run in SEVERAL IDENTICAL COPIES ("replicas")
// behind one reverse proxy: `docker compose -f docker-compose.prod.yml up -d
// --scale app=N`. Copies are drawn as a stack of cards. Nothing that would
// make one copy special is allowed to exist: no host port, no local disk, no
// state kept inside the process. Everything shared — the database, Redis and
// the object storage — sits outside the copies, and THAT is what lets any
// copy answer any request.

specification {
  element actor { style { shape person } }        // a human at the keyboard
  element system                                   // a ready-made external system
  element container                                // an app or a data store
  element infrastructure                            // machines, the registry, the test stand
  element component                                 // one page or route inside an app

  // Everything tagged #dev belongs to the DEVELOPER's contour: it exists for
  // the people who build the product, on their own machine, and no user ever
  // meets it. The production views (index, "What the system consists of" and
  // the flows) hide it; the "Developer contour" view shows it alone. Never read
  // a #dev element or arrow as something users depend on.
  tag dev
}

model {
  user = actor 'User' {
    description 'A person in a browser: opens the site, signs in via Logto, works with data. Downloads uploaded files straight from the object storage, through a link the API signed for them — see the "How an uploaded file reaches the user" view.'
  }

  engineer = actor 'Engineer (DevOps)' {
    description 'Builds and ships images by hand, and runs the scale-check stand before shipping. The template has NO CI by design: all checks live in git hooks (the submodules check their own code; the meta-repo hook checks its own artefacts — the stand config and the LikeC4 model — and scans the staged diff for secrets), and every deploy is an explicit command from docs/DEPLOY.md.'
  }

  lstack = system 'LiteStack' {
    description 'The product that comes out of the template: frontend, backend and their data. The meta-repo only glues the two submodules together and holds the shared contracts (ENV-CONTRACT, DEPLOY).'

    // The reverse proxy is the only container on this diagram that no template
    // compose file defines: it is Traefik from Dokploy, the host own nginx, or
    // the Caddy of the scale stand. Neither app publishes a host port, so
    // nothing is reachable from outside without it, and the apps find each
    // other by service name on the shared docker network (PROXY_NETWORK).
    proxy = container 'Reverse proxy (TLS)' {
      description 'The only way in from the internet. Three jobs. (1) It terminates HTTPS. (2) It spreads incoming requests across the copies of both apps, one after another (round robin), so the outside world sees a single address instead of N. (3) It decides WHICH copies get traffic, by polling their health endpoints and skipping the ones that stop answering. It is also what appends the caller real address to the X-Forwarded-For header — the header the backend rate limit is keyed on. Not part of the template: the hosting provides it.'
      technology 'Traefik / nginx / Caddy'
    }

    web = container 'Frontend «litefront»' {
      description 'Renders pages server-side (SSR) and serves static assets to the browser. Runs in several identical copies and keeps no state of its own, so any copy can render any page. ONE built image runs in EVERY environment: the public VITE_* values are read from the container environment when the server boots and handed to the browser inside the HTML (a window global), so moving the same image to another environment is a restart with different variables, never a rebuild. A missing required variable kills the process at boot and names it in the log — before the port is bound, so a half-configured copy never reports healthy. Healthcheck: wget on the static /health.txt, which costs no page render per probe. The container always listens on 3000 and publishes no host port (a fixed host port is exactly what stops a second copy from starting).'
      technology 'Vite · React 19 · TanStack Start · Nitro (Node 24)'
      style {
        multiple true
      }
    }

    api = container 'Backend «liteend»' {
      description 'GraphQL API: queries via POST /graphql, subscriptions over WebSocket (graphql-transport-ws protocol), file upload via POST /upload. It is also the only thing that can hand out a download link for a private file, by signing one on the spot. Runs in several identical copies and writes nothing to its own disk — an uploaded file goes straight to the object storage, so the next request may safely land on any other copy. TWO health endpoints, on purpose: /livez means "the process is running" and touches no database (the container HEALTHCHECK uses it, and a failed one gets the container restarted — a probe that pinged the database would restart the whole fleet the moment the database blinked), while /readyz means "I can take traffic right now" and does ping Postgres and Redis (the proxy uses it to route around a copy that lost a dependency). Both probes, like all API endpoints, propagate the X-Request-Id header for trace correlation. There is NO route that serves files back: downloads go to the storage directly. On startup every copy applies its goose migrations under a Postgres advisory lock — a database-wide "one at a time" flag — so copies booting together do not race: one migrates, the rest wait and find nothing to do. Migrations are forward only; there is no schema rollback. The container always listens on 4000 and publishes no host port.'
      technology 'Go · gqlgen · sqlc · goose · Asynq · minio-go'
      style {
        multiple true
      }

      // ---- The developer pages (routes of this very binary) ----
      // Not a separate app, not a separate deploy: four more routes in the same
      // Go process, registered in internal/app/app.go (mountRoutes). They ship
      // in EVERY build, production included — the only thing in front of them
      // is a login prompt (HTTP Basic Auth, ADMIN_USER / ADMIN_PASSWORD, code in
      // internal/middleware/basicauth.go). Three of them also run under a looser
      // content policy than the API, because they load scripts from a CDN
      // (devCSP in internal/devtools/devtools.go).
      devHome = component 'Page /dev — the launcher' {
        #dev
        description 'A plain page of links to everything a developer needs while working: the two pages below, the readiness check, and the four dashboards outside the app. It is nothing but links — the page loads nothing from the internet and opens with the network down. The dashboard addresses are not written into the page: they are built when the app starts, out of the configured ports (devLinks in internal/app/app.go).'
      }

      playground = component 'Page /playground — the GraphQL sandbox' {
        #dev
        description 'A page where a developer types a GraphQL query by hand and sees the answer. It sends those queries to /graphql — the same route the frontend uses, no shortcut around it. The page itself is almost empty: the program that draws it is downloaded from a CDN every time the page opens.'
        technology 'gqlgen playground'
      }

      docs = component 'Page /docs — the REST API reference' {
        #dev
        description 'A readable description of the handful of REST endpoints (/upload, /livez, /readyz): what to send and what comes back. Nobody writes this page by hand — it reads the spec file next to it and draws what it finds, so the two can never disagree. Like the sandbox, the program that draws it is downloaded from a CDN.'
        technology 'Scalar api-reference (version pinned exactly)'
      }

      openapi = component 'File /openapi.yaml — the spec itself' {
        #dev
        description 'The same REST description in machine-readable form, kept as a real file inside the binary (internal/devtools/openapi.yaml). A test compares it with the routes the app actually registers and fails when they drift apart. People normally read it through /docs; other programs read it directly.'
        technology 'OpenAPI 3.0.3 (YAML)'
      }

      devHome -> playground 'links to it' 'Just a link on the page. Nothing happens until a developer clicks.'
      devHome -> docs 'links to it' 'Just a link on the page.'
      docs -> openapi 'reads the spec and draws it' 'The browser fetches /openapi.yaml from the same address and the reference page is built from it — which is why the page can never describe an API different from the file.'
    }

    db = container 'PostgreSQL' {
      description 'The primary data store, SHARED by every backend copy — that sharing is what makes the copies interchangeable. In production it is a separate external service (e.g. a Dokploy native service with backups); docker-compose.prod.yml deliberately does not include it. Locally backend/docker-compose.yml brings it up.'
      technology 'PostgreSQL'
    }

    cache = container 'Redis' {
      description 'Shared by every backend copy and doing two jobs: it holds the Asynq background-job queue, and it carries GraphQL subscription events between copies (a Redis pub/sub channel). The second one is what keeps subscriptions working with N copies: the browser socket is held by one copy while the event may be published by another. Like Postgres — an external service in production, brought up by the backend compose in dev.'
      technology 'Redis'
    }

    files = container 'Object storage (S3-compatible)' {
      description 'Holds every uploaded file, and is shared by every backend copy. "S3-compatible" means it speaks the same HTTP protocol as Amazon S3, so any server implementing it fits: Garage (what the dev compose and the scale stand run), MinIO, or a cloud bucket. Who may read a file is set by FILE_VISIBILITY. By default it is PRIVATE: the bucket refuses anonymous readers outright, and the only way in is a link the API signed, which stops working after FILE_LINK_TTL_MINUTES. Switched to PUBLIC the bucket is world-readable instead and links never expire — simpler and cacheable, and anyone who ever saw a URL keeps that file forever. In production it is an external service, addressed by two different values: S3_ENDPOINT is how the APP reaches it from inside the network, S3_PUBLIC_BASE_URL is the link prefix the BROWSER resolves from outside. The two are never the same string.'
      technology 'Garage / MinIO / any S3 API'
    }

    proxy -> web 'spreads page requests across the copies' {
      description 'Round robin over every frontend copy on port 3000, found by docker service name on the shared network. Adding a copy is `--scale app=N` and nothing else — no port to pick, no config to edit.'
      technology 'HTTP'
    }
    proxy -> web 'asks: is this copy still alive?' 'Polls the static /health.txt every few seconds. A copy that stops answering is dropped from rotation until it answers again.'

    proxy -> api 'spreads API requests across the copies' {
      description 'Round robin over every backend copy on port 4000. The proxy APPENDS the caller real address on the RIGHT of X-Forwarded-For; the backend counts TRUSTED_PROXY_HOPS entries from the right (default 1) to find the client. That is why a client who forges the header gets no fresh rate-limit bucket: whatever it wrote stays to the left and is ignored. All requests propagate X-Request-Id for trace correlation.'
      technology 'HTTP + X-Forwarded-For + X-Request-Id'
    }
    proxy -> api 'asks: may this copy take traffic?' {
      description 'Polls /readyz every few seconds; that endpoint pings Postgres and Redis. A copy that lost its database is taken OUT OF ROTATION rather than restarted — restarting is what the liveness probe (/livez) in the image HEALTHCHECK is for. The probe propagates X-Request-Id for trace correlation.'
      technology 'HTTP + X-Request-Id'
    }

    web -> api 'sends GraphQL queries' {
      description 'POST /graphql with an Authorization: Bearer <JWT> header; subscriptions take the same route over WebSocket. The API address (VITE_GRAPHQL_API_URL) is read from the container environment at boot, so pointing the same image at another API is a restart, not a rebuild. The backend CORS_ORIGIN must include the frontend origin, or the browser blocks the requests and WebSocket subscriptions die with 403. Failed responses carry extensions.requestId — the id the backend stamps on every log line of that request; the frontend keeps it and shows it in the error screen, so one id joins both logs.'
      technology 'HTTPS/JSON + graphql-transport-ws'
    }
    api -> db 'reads and writes data' 'SQL through sqlc, against the one shared database. Each copy opens up to DB_POOL_MAX connections, so keep "number of copies × DB_POOL_MAX" below the database connection limit — otherwise the last copy to start cannot connect at all. At startup the embedded goose applies migrations under an advisory lock, forward-only: rolling the image back does NOT roll the schema back (see DEPLOY.md).'
    api -> cache 'queues jobs and publishes events' 'Asynq background jobs live in Redis, so a job queued by one copy may be executed by another. Subscription events go to a Redis pub/sub channel for the same reason — the copy holding the client socket is usually not the copy that published. In dev the queue is watched via the Asynqmon dashboard.'
    api -> files 'stores the uploaded file' {
      description 'PutObject through minio-go. The object key is a date folder plus a random UUID plus the sanitised extension — the extension is the only part taken from the client, and it is filtered, because a "/" or ".." inside a key would lift the object out of its folder. The app keeps no copy of the bytes. It answers with an absolute link the browser can use right now — signed, with an expiry, when files are private — plus the object key behind it. What the database keeps is the permanent form (S3_PUBLIC_BASE_URL + key), never a signature: a stored signature would expire and take the avatar with it.'
      technology 'S3 API (minio-go)'
    }
  }

  logto = system 'Logto (OIDC)' {
    description 'The external sign-in service. The browser goes through a redirect (OIDC PKCE) and receives a JWT — a signed token the backend uses to identify the user. Verification uses public keys (JWKS). In local development the backend has a mock mode instead.'
  }

  registry = infrastructure 'Container registry' {
    description 'Docker image storage: a Docker Hub namespace, ghcr.io, or your own self-hosted server. The name comes from IMAGE_REGISTRY (with a trailing slash), the tag from IMAGE_TAG (defaults to latest). One tag now names the code and nothing else — the same frontend tag is meant to run in every environment.'
  }

  buildsrv = infrastructure 'Build server' {
    description 'The machine that builds images with task docker:build (backend) / npm run docker:build (frontend). Just Docker and a repo checkout — no special software, there is no CI in this project.'
  }

  runsrv = infrastructure 'Run server' {
    description 'The machine that runs the images: docker compose -f docker-compose.prod.yml pull && up -d --scale app=N. Every copy of a side is started from the same image with the same variables; the shared Postgres, Redis and object storage are addressed by environment variables (DATABASE_HOST, REDIS_HOST, S3_ENDPOINT) and are NOT in the compose files. A missing required variable fails the deploy loudly, naming the variable, before any container starts.'
  }

  // Deliberately OUTSIDE the lstack boundary: the stand is not part of the
  // product, it is a local test rig in the meta-repo (scale/) that an engineer
  // runs by hand — same family as the build and run servers above. It runs two
  // copies of each side behind one Caddy plus its own Postgres, Redis and
  // Garage, and scripts/scale-check.sh drives the scenarios against it. Its
  // internals are not drawn: they are a throwaway mirror of what the views
  // below already show, and drawing them would suggest Caddy and Garage ship
  // with the product, which they do not.
  stand = infrastructure 'Scale-check stand (local, scale/)' {
    description 'A local rig that proves the copies are interchangeable BEFORE a release, since there is no CI. `docker compose -f scale/docker-compose.yml up -d --wait` brings up two copies of each side behind one Caddy, with a shared Postgres, Redis and a self-initialising Garage; then scripts/scale-check.sh runs four scenarios and prints ok/not ok for each: a file uploaded through copy A is downloadable and readable through copy B, two clients behind the proxy get independent rate-limit buckets while a forged X-Forwarded-For gets none, pages render on both frontend copies, and a subscription opened on one copy receives what another copy published. Not part of the product and never deployed.'
    technology 'docker compose · Caddy · Garage'
  }

  // ======== THE DEVELOPER CONTOUR (nothing here serves users) ========
  // Everything below is tagged #dev and is hidden from the production views.
  // Two groups: one public CDN the dev pages pull their scripts from, and four
  // ready-made dashboards that run only on a developer's own machine.

  jsdelivr = system 'cdn.jsdelivr.net (public CDN)' {
    #dev
    description 'A public file host for JavaScript libraries. The sandbox and the reference page are thin shells: the program that actually draws each of them is downloaded from here every time the page opens. That means a stranger machine supplies code that runs inside our page, so two locks are on it. (1) The reference script is asked for BY EXACT VERSION and with a checksum attached (SRI): if the CDN ever returns a file that does not match the checksum, the browser refuses to run it and the page stays blank — that is the lock working, not a breakage. (2) A rule (devCSP) lists the only two addresses these pages may talk to: our own server and this CDN. Anything else the browser blocks. Written down in docs/adr/0008-dev-pages-connect-src-is-not-open-https.md.'
  }

  // Four ready-made images started by backend/docker-compose.yml and by nothing
  // else — docker-compose.prod.yml does not know they exist. Their links on the
  // /dev page point at 127.0.0.1 ports (5100/5200/5300/5400 by default), so they
  // are reachable from the developer's own machine and from nowhere on the
  // network. The data they show is the LOCAL Postgres, Redis and Garage started
  // by the same compose file — never a production database.
  dash = infrastructure 'Admin dashboards (local dev compose only)' {
    #dev
    description 'Four ready-made web tools that let a developer look inside the data while working, instead of writing SQL and Redis commands by hand. They are not part of the product and are never deployed: backend/docker-compose.yml starts them, the production compose does not. All four sit behind one door.'
    technology 'docker compose (backend/docker-compose.yml)'

    adminProxy = container 'The one door (Caddy + login prompt)' {
      #dev
      description 'None of the four dashboards publishes a port of its own. This small proxy does — four addresses on the developer own machine (127.0.0.1:5100/5200/5300/5400) — and it asks for a login and password before letting anything through. Those four addresses are exactly what the links on /dev point at.'
      technology 'Caddy 2 + HTTP Basic Auth'
    }

    pgweb = container 'pgweb — database browser' {
      #dev
      description 'Shows the tables and rows of the local Postgres in a browser, and runs a query if you type one. The same idea as Prisma Studio.'
      technology 'sosedoff/pgweb'
    }

    redisInsight = container 'RedisInsight — Redis browser' {
      #dev
      description 'The official Redis viewer: lists keys, shows what is inside them. The connection to the local Redis is pre-filled, so there is nothing to set up.'
      technology 'redis/redisinsight'
    }

    asynqmon = container 'Asynqmon — background-job dashboard' {
      #dev
      description 'Shows the background jobs the backend queued: what is waiting, what is running, what failed and why — and lets a failed one be retried. The same idea as Bull Board.'
      technology 'hibiken/asynqmon'
    }

    garageUI = container 'Garage Web UI — file browser' {
      #dev
      description 'Lists the buckets and the uploaded files in the local object storage, so a developer can see that an upload really landed. It asks the Garage admin interface for the bucket key itself, so it needs no credentials of its own.'
      technology 'khairul169/garage-webui'
    }

    adminProxy -> pgweb 'passes the request on, once the password checked out'
    adminProxy -> redisInsight 'passes the request on, once the password checked out'
    adminProxy -> asynqmon 'passes the request on, once the password checked out'
    adminProxy -> garageUI 'passes the request on, once the password checked out'
  }

  engineer -> lstack.api.devHome 'opens /dev and enters the dev login' {
    description 'The four developer pages are ordinary routes of the backend, so they are opened at the app own address. The browser asks for a login and password first (basic auth); a wrong one gets a 401 and the page is never rendered. These pages exist in production builds too — which is why the password matters there and the default "admin/admin" must not survive a deploy.'
    technology 'HTTPS + HTTP Basic Auth'
  }
  engineer -> dash.adminProxy 'opens a dashboard from the links on /dev' 'Goes to one of the four 127.0.0.1 addresses and enters a login again — the dashboards have their own door, separate from the door of the app.'

  lstack.api.devHome -> dash.adminProxy 'links to the four dashboards' 'Plain hyperlinks, built at startup from the configured ports. The /dev page itself never calls the dashboards — the browser of the developer does, after a click.'

  lstack.api.playground -> jsdelivr 'downloads the program that draws the sandbox' {
    description 'Fetched when the page opens. Nothing else is fetched from outside: the queries the sandbox sends go to our own /graphql.'
    technology 'HTTPS'
  }
  lstack.api.docs -> jsdelivr 'downloads the program that draws the reference' {
    description 'Asked for by exact version and with a checksum (SRI) attached, so a replaced file will not run. Note for whoever opens the browser console here: two blocked-request errors about api.scalar.com show up on every load. That is the rule in ADR-0008 stopping the downloaded program from phoning its own home. Do not "fix" it by widening the rule.'
    technology 'HTTPS'
  }

  dash.pgweb -> lstack.db 'reads the tables and rows'
  dash.redisInsight -> lstack.cache 'reads the keys'
  dash.asynqmon -> lstack.cache 'reads the job queue' 'Asynq keeps its queues inside Redis, so the dashboard reads them straight out of Redis; the backend is not involved.'
  dash.garageUI -> lstack.files 'lists buckets and uploaded files'

  user -> lstack.proxy 'opens the site over HTTPS'
  user -> lstack.files 'downloads uploaded files DIRECTLY' {
    description 'The reference kept in the database points straight at the storage (S3_PUBLIC_BASE_URL — either the storage own public domain, or a path the reverse proxy forwards to it). The browser fetches the bytes from there and the application is not involved in the download at all: no backend route serves files, and no copy could serve them anyway, since none of them holds the file. What the application DOES decide is whether the request is allowed: with private files (the default) every read gets a freshly signed link that expires, so a link copied out of a page stops working; with public files the link is permanent and cacheable.'
    technology 'HTTP GET'
  }

  lstack.web -> logto 'redirects to sign-in (OIDC PKCE)' 'A redirect to Logto and back with the code; the tenant address (VITE_OIDC_AUTHORITY) comes from the container environment at boot, so one image signs in against any tenant.'
  lstack.api -> logto 'verifies the JWT against JWKS' 'Fetches public keys (OIDC_JWKS_URI) and checks the audience (OIDC_AUDIENCE). The audience must equal the frontend VITE_OIDC_API_RESOURCE — otherwise 401 on every request.'

  engineer -> buildsrv 'builds the images'
  buildsrv -> registry 'pushes the images' 'docker push <IMAGE_REGISTRY>liteend|litefront:<IMAGE_TAG>; for a private registry — docker login first. The frontend image carries no environment inside it any more, so the very same tag can be promoted from staging to production without a rebuild.'
  engineer -> stand 'runs the scale check before shipping' 'Brings the stand up by hand and runs scripts/scale-check.sh. Never in a git hook: starting four containers is far too slow for a commit, so for the stand the hook only checks its compose file and Caddyfile syntax.'
  engineer -> runsrv 'ships the release'
  runsrv -> registry 'pulls the images' 'docker compose -f docker-compose.prod.yml pull. Both prod composes have no build: on purpose: a failed pull fails the deploy instead of silently rebuilding whatever sits on the host.'
}

views {
  view index {
    title 'LiteStack: who talks to whom'
    include *
  }

  view ofLstack of lstack {
    title 'What the system consists of'
    include *
    include logto
  }

  dynamic view requestFlow {
    title 'A user request, step by step'
    user -> lstack.proxy 'Step 1: the browser opens the site over HTTPS'
    lstack.proxy -> lstack.web 'Step 2: the proxy passes the request to the NEXT frontend copy in turn, choosing only among the copies whose /health.txt still answers; that copy renders the page — any of them can, they hold no state'
    user -> logto 'Step 3: sign-in — the browser goes to Logto (OIDC PKCE) and returns with tokens'
    user -> lstack.proxy 'Step 4: the browser sends POST /graphql with a Bearer JWT; subscriptions take the same path over WebSocket'
    lstack.proxy -> lstack.api 'Step 5: the proxy hands it to the next backend copy that answers /readyz (requests and probes propagate X-Request-Id) — that probe pings Postgres and Redis, so a copy which lost a dependency is skipped instead of being restarted'
    lstack.api -> logto 'Step 6: that copy verifies the token signature against the public keys (JWKS)'
    lstack.api -> lstack.db 'Step 7: runs SQL through sqlc against the shared database — which is why it does not matter which copy answered'
    lstack.api -> lstack.cache 'Step 8: long operations become Asynq jobs (carrying request_id in payloads), and subscription events are published to Redis so a socket held by another copy still receives them'
  }

  dynamic view fileFlow {
    title 'How an uploaded file reaches the user, step by step'
    user -> lstack.proxy 'Step 1: the browser sends the file — POST /upload as multipart, with a Bearer JWT'
    lstack.proxy -> lstack.api 'Step 2: the proxy hands it to one copy — say copy A. Which one is not important, and nobody remembers the choice'
    lstack.api -> lstack.files 'Step 3: copy A checks the type and size, builds a safe object key (date + random UUID + filtered extension) and PUTs the bytes into the shared storage. Nothing is written to the container disk'
    lstack.api -> lstack.db 'Step 4: it stores the file metadata — including WHO uploaded it — plus the PERMANENT reference to the object (S3_PUBLIC_BASE_URL + key), a plain string, never a signature, because a signature expires. The uploader is recorded because a key is not a secret: it travels in every link, so when a client later says "this file is my avatar" the API checks that row before signing anything, and refuses a file the caller did not upload'
    lstack.api -> user 'Step 5: the response carries that key AND a ready-to-use link: signed and short-lived when files are private, the permanent one when they are public. The page shows the file immediately either way'
    user -> lstack.files 'Step 6: THE IMPORTANT PART — the browser follows that link into the storage itself. No application copy touches the download; asking any copy for the file would be pointless because none of them has it. With private files the signature in the URL is the whole authorisation, and the same URL without it is refused — which is why every read of the profile asks the API for a fresh link (any copy can sign one, they share the key)'
  }

  dynamic view deployFlow {
    title 'Deploy via the registry, step by step'
    engineer -> buildsrv 'Step 1: starts the image build (task docker:build / npm run docker:build)'
    buildsrv -> registry 'Step 2: pushes the images, after docker login for a private registry'
    engineer -> stand 'Step 3: optional but cheap — brings the local stand up and runs scripts/scale-check.sh; a red check here is a bug that would only show up with N copies in production'
    engineer -> runsrv 'Step 4: sets IMAGE_REGISTRY and IMAGE_TAG on the target host, calls docker compose pull for both sides'
    runsrv -> registry 'Step 5: pulls the images; if the digest did not change, up -d is a no-op — verify with docker compose images'
    engineer -> runsrv 'Step 6: `up -d --scale app=N` brings up N copies of each side; the first backend copy to get the advisory lock runs goose migrations (forward-only) while the others wait'
  }
}
