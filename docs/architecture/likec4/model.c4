// LiteStack architecture diagrams (LikeC4 format).
// Run from the META-REPO ROOT (likec4 is a devDependency there):
//   browse:   npm run likec4:start
//   validate: npm run likec4:validate
// Fallback without an install: npx -y likec4@1 <command> docs/architecture/likec4
// (the CLI major is pinned: the scoped @likec4/cli package is a dead 0.x line
// without the validate command). Tested with likec4 1.59.2.
// Rule: changed code or deploy configs (compose/Dockerfile/ENV-CONTRACT) —
// update this diagram in the same commit.
//
// LiteStack is a boilerplate meta-repository: it owns no application code,
// only two submodules (backend/ = liteend-go, frontend/ = litefront) and the
// shared contracts. The diagram shows the system as it lives in production,
// plus the "build server → registry → run server" deployment path from
// docs/DEPLOY.md.

specification {
  element actor { style { shape person } }        // a human at the keyboard
  element system                                   // a ready-made external system
  element container                                // an app or a data store
  element infrastructure                            // machines and the image registry
}

model {
  user = actor 'User' {
    description 'A person in a browser: opens the site, signs in via Logto, works with data.'
  }

  engineer = actor 'Engineer (DevOps)' {
    description 'Builds and ships images by hand. The template has NO CI by design: all checks live in the submodules git hooks, and every deploy is an explicit command from docs/DEPLOY.md.'
  }

  lstack = system 'LiteStack' {
    description 'The product that comes out of the template: frontend, backend and their data. The meta-repo only glues the two submodules together and holds the shared contracts (ENV-CONTRACT, DEPLOY).'

    // The reverse proxy is the only container on this diagram that no template
    // compose file defines: it is Traefik from Dokploy or the host own nginx.
    // Both apps publish on 127.0.0.1 only, so nothing is reachable from
    // outside without it.
    proxy = container 'Reverse proxy (TLS)' {
      description 'Accepts HTTPS from the internet and forwards to the apps. Not part of the template — the hosting provides it (Traefik in Dokploy or your own nginx); it also terminates TLS.'
    }

    web = container 'Frontend «litefront»' {
      description 'Renders pages server-side (SSR) and serves static assets to the browser. All VITE_* values are baked into the JS bundle at build time, so one image fits exactly one environment; at runtime it reads only PORT=3000. Healthcheck — wget on the static /health.txt (no SSR render per probe) — is baked into the Dockerfile.'
      technology 'Vite · React 19 · TanStack Start · Nitro (Node 22)'
    }

    api = container 'Backend «liteend»' {
      description 'GraphQL API: queries via POST /graphql, subscriptions over WebSocket (graphql-transport-ws protocol), file upload /upload (served at /uploads). On every startup it applies goose migrations itself — forward only, there is no schema rollback. The container always listens on port 4000. Healthcheck (/app/server -healthcheck) is baked into the Dockerfile.'
      technology 'Go · gqlgen · sqlc · goose · Asynq'
    }

    db = container 'PostgreSQL' {
      description 'The primary data store. In production it is a separate external service (e.g. a Dokploy native service with backups) — docker-compose.prod.yml deliberately does not include it; locally backend/docker-compose.yml brings it up.'
      technology 'PostgreSQL'
    }

    cache = container 'Redis' {
      description 'Asynq background-job queue and backend housekeeping. Like Postgres — an external service in production, brought up by the backend compose in dev.'
      technology 'Redis'
    }

    proxy -> web 'forwards requests to the SSR app' 'On the host the container is published at 127.0.0.1:3000; the host-side number of the port mapping is picked by the PORT variable.'
    proxy -> api 'proxies requests to the API' 'On the host — 127.0.0.1:4000; PORT selects the host-side port, inside the container it is always 4000.'

    web -> api 'sends GraphQL queries' {
      description 'POST /graphql with an Authorization: Bearer <JWT> header; subscriptions take the same route over WebSocket. The API address (VITE_GRAPHQL_API_URL) is baked into the bundle at build time — moving the API domain requires rebuilding the frontend. The backend CORS_ORIGIN must include the frontend origin, or the browser blocks the requests and WebSocket subscriptions die with 403.'
      technology 'HTTPS/JSON + graphql-transport-ws'
    }
    api -> db 'reads and writes data' 'SQL through sqlc. At container startup the embedded goose applies migrations forward-only: rolling the image back does NOT roll the schema back (see DEPLOY.md).'
    api -> cache 'enqueues background jobs' 'Asynq jobs live in Redis; in dev the queue is watched via the Asynqmon dashboard.'
  }

  logto = system 'Logto (OIDC)' {
    description 'The external sign-in service. The browser goes through a redirect (OIDC PKCE) and receives a JWT — a signed token the backend uses to identify the user. Verification uses public keys (JWKS). In local development the backend has a mock mode instead.'
  }

  registry = infrastructure 'Container registry' {
    description 'Docker image storage: a Docker Hub namespace, ghcr.io, or your own self-hosted server. The name comes from IMAGE_REGISTRY (with a trailing slash), the tag from IMAGE_TAG (defaults to latest).'
  }

  buildsrv = infrastructure 'Build server' {
    description 'The machine that builds images with task docker:build (backend) / npm run docker:build (frontend). Just Docker and a repo checkout — no special software, there is no CI in this project.'
  }

  runsrv = infrastructure 'Run server' {
    description 'The machine that runs the images: docker compose -f docker-compose.prod.yml pull && up -d. A .env file is NOT required: the frontend needs nothing at runtime, the backend is satisfied by exported environment variables — missing required ones fail the deploy loudly, naming the variable.'
  }

  user -> lstack.proxy 'opens the site over HTTPS'

  lstack.web -> logto 'redirects to sign-in (OIDC PKCE)' 'A redirect to Logto and back with the code; the tenant address (VITE_OIDC_AUTHORITY) is baked into the bundle at build time.'
  lstack.api -> logto 'verifies the JWT against JWKS' 'Fetches public keys (OIDC_JWKS_URI) and checks the audience (OIDC_AUDIENCE). The audience must equal the frontend VITE_OIDC_API_RESOURCE — otherwise 401 on every request.'

  engineer -> buildsrv 'builds the images'
  buildsrv -> registry 'pushes the images' 'docker push <IMAGE_REGISTRY>liteend|litefront:<IMAGE_TAG>; for a private registry — docker login first. Tags are strictly per environment: prod-v1.2.0, staging-v1.2.0 — never a shared latest.'
  engineer -> runsrv 'ships the release'
  runsrv -> registry 'pulls the images' 'docker compose -f docker-compose.prod.yml pull. Both prod composes have no build: on purpose: a failed pull fails the deploy instead of silently rebuilding whatever sits on the host.'
}

views {
  view index {
    title 'LiteStack: who talks to whom'
    include *
  }

  view ofLstack of lstack {
    title 'What the system consists of'
    include *
    include logto
  }

  dynamic view requestFlow {
    title 'A user request, step by step'
    user -> lstack.proxy 'Step 1: the browser opens the site over HTTPS'
    lstack.proxy -> lstack.web 'Step 2: the proxy routes to the SSR container, Nitro renders the page'
    user -> logto 'Step 3: sign-in — the browser goes to Logto (OIDC PKCE) and returns with tokens'
    user -> lstack.api 'Step 4: the browser sends POST /graphql with a Bearer JWT; subscriptions take the same path over WebSocket'
    lstack.api -> logto 'Step 5: the backend verifies the token signature against the public keys (JWKS)'
    lstack.api -> lstack.db 'Step 6: runs SQL through sqlc'
    lstack.api -> lstack.cache 'Step 7: long operations go into Asynq background jobs'
  }

  dynamic view deployFlow {
    title 'Deploy via the registry, step by step'
    engineer -> buildsrv 'Step 1: starts the image build (task docker:build / npm run docker:build)'
    buildsrv -> registry 'Step 2: pushes images tagged per environment (prod-/staging-), after docker login for a private registry'
    engineer -> runsrv 'Step 3: sets IMAGE_REGISTRY and IMAGE_TAG on the target host, calls docker compose pull for both sides'
    runsrv -> registry 'Step 4: pulls the images; if the digest did not change, up -d is a no-op — verify with docker compose images'
    engineer -> runsrv 'Step 5: up -d brings the containers up; the backend runs goose migrations itself at startup (forward-only)'
  }
}
